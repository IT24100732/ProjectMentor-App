import { useCallback, useEffect, useState } from 'react';
import { Link, useParams } from 'react-router-dom';
import { getRoadmapExecution } from '../api/projectMentorApi';
import { useAuth } from '../auth/AuthContext';

// Friendly, human descriptions for each agent so the page reads like a story, not a log.
const AGENT_META = {
  Planner: { n: '01', title: 'Planner', role: 'Reads your answers and builds the step-by-step plan.' },
  ResourceAgent: { n: '02', title: 'Resource Agent', role: 'Finds tutorials and videos for each milestone.' },
  AnalysisAgent: { n: '03', title: 'Analysis Agent', role: 'Checks the plan is realistic and covers every phase.' },
  ValidationAgent: { n: '04', title: 'Validation Agent', role: 'Runs strict pass/fail rule checks before approval.' },
};

const STATUS_STYLE = {
  Success: { cls: 'ok', label: '✓ Success' },
  Failed: { cls: 'fail', label: '✗ Failed' },
  Running: { cls: 'run', label: '● Running' },
  Pending: { cls: 'pend', label: '○ Pending' },
};

function getErrorMessage(error) {
  if (error.code === 'API_UNREACHABLE') return error.message;
  return error.message || 'Something went wrong. Please try again.';
}

// Turn an agent's raw JSON output into one friendly sentence.
function summarise(agent, output) {
  if (!output) return null;
  let data;
  try { data = JSON.parse(output); } catch { return null; }
  switch (agent) {
    case 'Planner':
      return Array.isArray(data) ? `Planned ${data.length} milestones across the project.` : null;
    case 'ResourceAgent':
      return typeof data.attached === 'number' ? `Attached ${data.attached} learning resources.` : null;
    case 'AnalysisAgent':
      return `Covers all phases: ${data.coversAllPhases ? 'yes' : 'no'} · Fits the deadline: ${data.endsBeforeDeadline ? 'yes' : 'no'}.`;
    case 'ValidationAgent':
      return data.passed ? 'All checks passed — plan is safe to release.' : `Rejected: ${(data.errors || []).join(', ') || 'failed validation'}.`;
    default:
      return null;
  }
}

function StatusBadge({ status }) {
  const s = STATUS_STYLE[status] ?? STATUS_STYLE.Pending;
  return <span className={`agent-badge ${s.cls}`}>{s.label}</span>;
}

export default function AgentWorkflowPage() {
  const { id } = useParams();
  const { token } = useAuth();
  const [run, setRun] = useState(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');

  const load = useCallback(async () => {
    setLoading(true); setError('');
    try {
      setRun(await getRoadmapExecution(token, id));
    } catch (exception) {
      setError(exception.status === 404 ? 'No AI workflow found for this roadmap yet.' : getErrorMessage(exception));
      setRun(null);
    } finally {
      setLoading(false);
    }
  }, [token, id]);

  useEffect(() => { load(); }, [load]);

  return (
    <main className="page">
      <div className="page-head">
        <div>
          <p className="eyebrow">Agentic AI · Execution history</p>
          <h1>How your plan was built.</h1>
        </div>
        <Link className="button button-quiet button-small" to={`/student/roadmaps/${id}`}>← Back to roadmap</Link>
      </div>
      <p className="page-lede">Four specialised agents each did one job, used only their allowed tools, and left this auditable trail. Nothing went live until you approved it.</p>

      {loading && <section className="panel"><p>Loading the workflow…</p></section>}
      {error && !loading && <p className="error-message" role="alert">{error}</p>}

      {run && !loading && (
        <>
          <section className="panel">
            <div className="status-row">
              <span className="chip">Objective · {run.objective}</span>
              <span className={`chip${run.status === 'Failed' ? ' gold' : ''}`}>Run · {run.status}</span>
              {run.totalDurationMs != null && <span className="chip gold">Took · {run.totalDurationMs} ms</span>}
            </div>
          </section>

          <div className="agent-timeline">
            {run.steps.map((step) => {
              const meta = AGENT_META[step.agent] ?? { n: String(step.order).padStart(2, '0'), title: step.agent, role: '' };
              const summary = summarise(step.agent, step.output);
              return (
                <article className={`agent-card ${(STATUS_STYLE[step.status] ?? {}).cls ?? ''}`} key={step.order}>
                  <div className="agent-no">{meta.n}</div>
                  <div className="agent-body">
                    <div className="agent-top">
                      <h3>{meta.title}</h3>
                      <StatusBadge status={step.status} />
                    </div>
                    <p className="agent-role">{meta.role}</p>
                    {summary && <p className="agent-summary">{summary}</p>}
                    <div className="agent-tools">
                      {step.toolCalls.length > 0
                        ? step.toolCalls.map((t, i) => (
                            <span className={`tool-chip${t.success ? '' : ' bad'}`} key={i}>
                              🔧 {t.tool}{t.success ? '' : ' · failed'}
                            </span>
                          ))
                        : <span className="tool-chip muted">no tools used</span>}
                      {step.durationMs != null && <span className="agent-dur">{step.durationMs} ms</span>}
                    </div>
                  </div>
                </article>
              );
            })}
          </div>

          <section className="panel">
            <h2>Validation checks</h2>
            <p className="note">Deterministic rules run before the plan is allowed through.</p>
            <ul className="check-list">
              {run.validations.map((v, i) => (
                <li className={v.passed ? 'ok' : 'fail'} key={i}>
                  <span className="check-mark">{v.passed ? '✓' : '✗'}</span>
                  <span><strong>{v.rule}</strong>{v.details ? ` — ${v.details}` : ''}</span>
                </li>
              ))}
              {run.validations.length === 0 && <li className="muted">No validation results recorded.</li>}
            </ul>
          </section>

          <section className="panel approval-gate">
            <h2>Human approval gate</h2>
            {run.approval
              ? <p className="agent-summary">
                  {run.approval.decision === 'Accepted' ? '✓ You accepted this roadmap.' : '↩ You requested a revision.'}
                  {run.approval.comment ? ` — “${run.approval.comment}”` : ''}
                </p>
              : <>
                  <p className="note">This roadmap is still waiting for your decision — the high-impact step is paused until you approve it.</p>
                  <Link className="button button-primary button-small" to={`/student/roadmaps/${id}`}>Review & approve →</Link>
                </>}
          </section>
        </>
      )}
    </main>
  );
}
