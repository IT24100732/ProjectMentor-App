import { useEffect, useRef, useState } from 'react';
import { Link, useLocation, useNavigate, useParams } from 'react-router-dom';
import { planRoadmap, sendChat } from '../api/projectMentorApi';
import { useAuth } from '../auth/AuthContext';

function getErrorMessage(error) {
  if (error.code === 'API_UNREACHABLE') return error.message;
  return error.message || 'Something went wrong. Please try again.';
}

// Carry the chosen title/summary across the chat step (survives a refresh via sessionStorage).
function useProjectContext(id, locationState) {
  const key = `pm.chat.${id}`;
  if (locationState?.title) {
    try { sessionStorage.setItem(key, JSON.stringify(locationState)); } catch { /* ignore */ }
    return locationState;
  }
  try { return JSON.parse(sessionStorage.getItem(key) || '{}'); } catch { return {}; }
}

export default function StudentChatPage() {
  const { id } = useParams();
  const { token } = useAuth();
  const navigate = useNavigate();
  const location = useLocation();
  const ctx = useProjectContext(id, location.state);

  const [messages, setMessages] = useState([]);   // {role:'assistant'|'user', content}
  const [input, setInput] = useState('');
  const [thinking, setThinking] = useState(false);
  const [ready, setReady] = useState(false);
  const [generating, setGenerating] = useState(false);
  const [error, setError] = useState('');
  const endRef = useRef(null);
  const started = useRef(false);

  // Kick off the conversation once.
  useEffect(() => {
    if (started.current) return;
    started.current = true;
    (async () => {
      setThinking(true);
      try {
        const res = await sendChat(token, id, []);
        setMessages([{ role: 'assistant', content: res.reply }]);
        setReady(res.ready);
      } catch (exception) {
        setError(getErrorMessage(exception));
      } finally {
        setThinking(false);
      }
    })();
  }, [token, id]);

  useEffect(() => { endRef.current?.scrollIntoView({ behavior: 'smooth' }); }, [messages, thinking]);

  async function send(event) {
    event.preventDefault();
    const text = input.trim();
    if (!text || thinking) return;
    const next = [...messages, { role: 'user', content: text }];
    setMessages(next);
    setInput('');
    setThinking(true);
    setError('');
    try {
      const res = await sendChat(token, id, next);
      setMessages(m => [...m, { role: 'assistant', content: res.reply }]);
      setReady(res.ready);
    } catch (exception) {
      setError(getErrorMessage(exception));
    } finally {
      setThinking(false);
    }
  }

  async function generate() {
    setGenerating(true);
    setError('');
    try {
      // Fold the conversation into a brief the Planner can use.
      const answers = messages.filter(m => m.role === 'user').map(m => m.content).join(' · ');
      const brief = [ctx.summary, answers && `Student's notes: ${answers}`].filter(Boolean).join('\n');
      await planRoadmap(token, id, { title: ctx.title || null, summary: brief || null });
      try { sessionStorage.removeItem(`pm.chat.${id}`); } catch { /* ignore */ }
      navigate(`/student/roadmaps/${id}`);
    } catch (exception) {
      setError(getErrorMessage(exception));
      setGenerating(false);
    }
  }

  return (
    <main className="page">
      <div className="page-head">
        <div>
          <p className="eyebrow">Mentor chat · shape your project</p>
          <h1>{ctx.title || 'Tell me about your project'}</h1>
        </div>
        <Link className="button button-quiet button-small" to="/student">← Start over</Link>
      </div>
      <p className="page-lede">A few quick questions so the roadmap is truly yours. Answer in your own words — then generate the plan.</p>

      <section className="panel chat-panel">
        <div className="chat-log">
          {messages.map((m, i) => (
            <div className={`chat-msg ${m.role}`} key={i}>
              <span className="chat-who">{m.role === 'assistant' ? 'Mentor' : 'You'}</span>
              <p>{m.content}</p>
            </div>
          ))}
          {thinking && <div className="chat-msg assistant"><span className="chat-who">Mentor</span><p className="chat-typing">…</p></div>}
          <div ref={endRef} />
        </div>

        <form className="chat-input" onSubmit={send}>
          <input
            type="text"
            value={input}
            onChange={e => setInput(e.target.value)}
            placeholder={ready ? 'Add anything else, or generate your roadmap →' : 'Type your answer…'}
            disabled={generating}
          />
          <button className="button button-quiet button-small" type="submit" disabled={thinking || generating || !input.trim()}>Send</button>
        </form>
      </section>

      <div className="hero-actions">
        <button className={`button ${ready ? 'button-primary' : 'button-gold'}`} onClick={generate} disabled={generating || messages.length === 0}>
          {generating ? 'Building your roadmap…' : 'Generate roadmap →'}
        </button>
        {!ready && <span className="note" style={{ alignSelf: 'center' }}>Answer a few questions first for the best plan — or generate now.</span>}
      </div>

      {error && <p className="error-message" role="alert">{error}</p>}
    </main>
  );
}
